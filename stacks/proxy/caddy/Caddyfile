# One block per site. Reloads by itself when this file changes (--watch).
{
	email nilseckerle2001@protonmail.com
}

qyo7ixnxmemepulm.myfritz.net {
	# Gitea under /git/ ; the prefix is stripped, ROOT_URL tells Gitea about it.
	redir /git /git/
	handle_path /git/* {
		reverse_proxy gitea:3000
	}

	# Foundry under /foundry ; it knows its prefix (FOUNDRY_ROUTE_PREFIX), so NO stripping here.
	# No redirect of our own: Foundry itself redirects /foundry/ -> /foundry, and a rule
	# in the other direction makes a redirect loop.
	@foundry path /foundry /foundry/*
	handle @foundry {
		reverse_proxy foundry:30000
	}
	redir /join /foundry/join    # old player link keeps working

  # n8n under /n8n ; it knows its prefix (N8N_PATH), so NO stripping here.
  # Webhooks live under /n8n/webhook/... and WebSockets work through reverse_proxy as is.
  @n8nstatic path /n8n/assets/* /n8n/static/* /n8n/favicon.ico /n8n/rest/* /n8n/types/* /n8n/icons/*
  handle @n8nstatic {
      uri strip_prefix /n8n
      reverse_proxy n8n:5678
  }
  @n8n path /n8n /n8n/*
  handle @n8n {
      reverse_proxy n8n:5678
  }

	# Dozzle (container logs) under /logs ; it knows its prefix (DOZZLE_BASE), so NO stripping.
	# Protected by basic auth: user "admin". Change the hash with: caddy hash-password
	@logs path /logs /logs/*
	handle @logs {
		basic_auth {
			admin $2a$14$M5eNL.oKgoJNILq5sECf6.PGoDQFAEksyoLzED6bF5t3PY9ATz0Zy
		}
		reverse_proxy dozzle:8080
	}

	# Matrix: fixed paths at the root, no prefix, no stripping.
	@matrix path /_matrix/* /_synapse/client/*
	handle @matrix {
		reverse_proxy synapse:8008
	}

	# Delegation so federation works over 443 (no port 8448 needed).
	handle /.well-known/matrix/server {
		header Content-Type application/json
		respond `{"m.server": "qyo7ixnxmemepulm.myfritz.net:443"}`
	}
	handle /.well-known/matrix/client {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{"m.homeserver": {"base_url": "https://qyo7ixnxmemepulm.myfritz.net"}}`
	}

	# Everything else: the service overview page (stacks/proxy/site).
	handle {
		root * /srv/site
		file_server
	}
}
