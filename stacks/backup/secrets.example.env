# Copy to secrets.env, fill in, then:
#   sops -e secrets.env > secrets.enc.env && rm secrets.env
RESTIC_PASSWORD=change-me-long-and-random
SB_USER=u123456
SB_HOST=u123456.your-storagebox.de
SB_PORT=23
# relative to the box home (no leading slash)
SB_PATH=restic
# base64 -w0 ~/.ssh/storagebox_ed25519
SB_SSH_KEY_B64=
# ssh-keyscan -p 23 -t ed25519 u123456.your-storagebox.de | base64 -w0
SB_KNOWN_HOSTS_B64=
